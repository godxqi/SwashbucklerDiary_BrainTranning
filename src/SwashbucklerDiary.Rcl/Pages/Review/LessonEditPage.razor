@page "/lesson"
@namespace SwashbucklerDiary.Rcl.Pages
@inherits ImportantComponentBase

@*课题记录表单。思想来源（只是解释框架，不是原典逐字引用）：
  「课题」借自阿德勒的「人生课题」（工作/交友/爱）与「课题分离」，经岸见一郎
  《被讨厌的勇气》通俗化；「每个人都是来给你上课的」是新时代/佛教缘起的流行说法
  （Caroline Myss《神圣契约》, 2001；Brian Weiss《前世今生》, 1988），属于意义框架，
  不是实证心理学。这个页面只把它当自省工具。*@

<div class="d-flex flex-column" style="height:100%;">
    <MyAppBar Title="@(I18n.T("Lesson record"))"
              OnClick="NavigateToBack">
    </MyAppBar>

    <ScrollContainer>
        <div class="review-form">
            <div class="review-section">
                <div class="review-label">@(I18n.T("When it happened"))</div>
                <MButton Class="review-add"
                         OnClick="@(() => showDatePicker = true)">
                    <MIcon Left="true">event</MIcon>
                    @occurredTime.ToString("yyyy/MM/dd")
                </MButton>
            </div>

            @*人物不是「课题的原因」，只是索引：人物标签负责「和谁」，类型/触因负责「哪类功课」。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("Person"))</div>
                <div class="review-desc">@(I18n.T(LessonText.PersonDescription))</div>
                <MChipGroup Class="review-chip-group"
                            Multiple="true">
                    @foreach (var tag in personTags)
                    {
                        <MChip @key="tag.Id"
                               Class="@ChipClass(personTagId == tag.Id)"
                               Filter="true"
                               IsActive="personTagId == tag.Id"
                               OnClick="@(() => SelectPerson(tag))">
                            @tag.Name
                        </MChip>
                    }
                    <MChip Class="review-chip"
                           IsActive="false"
                           OnClick="@(() => showAddPerson = true)">
                        <MIcon Left="true">add</MIcon>
                        @(I18n.T("Add"))
                    </MChip>
                </MChipGroup>
            </div>

            @*事件只写可观察的行为和原话，不写评判。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("What happened"))</div>
                <div class="review-desc">@(I18n.T(LessonText.EventDescription))</div>
                <MTextarea @bind-Value="eventText"
                           @bind-Value:after="MarkDirty"
                           Class="review-textarea"
                           Rows="3">
                </MTextarea>
            </div>

            @*触因和状态管理表共用标签，两边的次数合并计算。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("Trigger"))</div>
                <div class="review-desc">@(I18n.T(LessonText.TriggerDescription))</div>
                <MChipGroup Class="review-chip-group"
                            Multiple="true">
                    @foreach (var trigger in triggers)
                    {
                        <MChip @key="trigger.Tag.Id"
                               Class="@ChipClass(triggerTagId == trigger.Tag.Id)"
                               Filter="true"
                               IsActive="triggerTagId == trigger.Tag.Id"
                               OnClick="@(() => SelectTrigger(trigger.Tag.Id))">
                            @trigger.Tag.Name
                            <span class="review-group-index">@trigger.Count</span>
                        </MChip>
                    }
                    <MChip Class="review-chip"
                           IsActive="false"
                           OnClick="@(() => showAddTrigger = true)">
                        <MIcon Left="true">add</MIcon>
                        @(I18n.T("Add"))
                    </MChip>
                </MChipGroup>
            </div>

            @*四层感受：身体/想法/情绪/意义感。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("My reaction"))</div>
                <div class="review-desc">@(I18n.T(LessonText.ReactionDescription))</div>
                <div class="review-subitem">
                    <div class="review-subitem-label">@(I18n.T("Physical"))</div>
                    <MTextarea @bind-Value="reactionBody"
                               @bind-Value:after="MarkDirty"
                               Class="review-textarea"
                               Rows="2">
                    </MTextarea>
                </div>
                <div class="review-subitem">
                    <div class="review-subitem-label">@(I18n.T("Mental"))</div>
                    <MTextarea @bind-Value="reactionMind"
                               @bind-Value:after="MarkDirty"
                               Class="review-textarea"
                               Rows="2">
                    </MTextarea>
                </div>
                <div class="review-subitem">
                    <div class="review-subitem-label">@(I18n.T("Emotional"))</div>
                    <MTextarea @bind-Value="reactionEmotion"
                               @bind-Value:after="MarkDirty"
                               Class="review-textarea"
                               Rows="2">
                    </MTextarea>
                </div>
                <div class="review-subitem">
                    <div class="review-subitem-label">@(I18n.T("Spiritual"))</div>
                    <MTextarea @bind-Value="reactionSpirit"
                               @bind-Value:after="MarkDirty"
                               Class="review-textarea"
                               Rows="2">
                    </MTextarea>
                </div>
            </div>

            <div class="review-section">
                <div class="review-label">@(I18n.T("What it mirrors"))</div>
                <div class="review-desc">@(I18n.T(LessonText.MirrorDescription))</div>
                <MTextarea @bind-Value="mirror"
                           @bind-Value:after="MarkDirty"
                           Class="review-textarea"
                           Rows="3">
                </MTextarea>
            </div>

            <div class="review-section">
                <div class="review-label">@(I18n.T("Boundary"))</div>
                <div class="review-desc">@(I18n.T(LessonText.BoundaryDescription))</div>
                <MTextarea @bind-Value="boundary"
                           @bind-Value:after="MarkDirty"
                           Class="review-textarea"
                           Rows="3">
                </MTextarea>
            </div>

            @*带走一句：句子先写下来，再像周课 2.4 的归档块那样收进已有的某一栏。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("One line to keep"))</div>
                <div class="review-desc">@(I18n.T(LessonText.TakeawayDescription))</div>
                <MTextarea @bind-Value="takeaway"
                           @bind-Value:after="MarkDirty"
                           Class="review-textarea"
                           Rows="2">
                </MTextarea>

                <div class="review-subitem-label">@(I18n.T("Archive to"))</div>
                <MChipGroup Class="review-chip-group"
                            Multiple="true">
                    @foreach (var target in archiveTargets)
                    {
                        <MChip @key="target"
                               Class="@ChipClass(archiveTarget == target)"
                               Filter="true"
                               IsActive="archiveTarget == target"
                               OnClick="@(() => archiveTarget = target)">
                            @ArchiveTargetName(target)
                        </MChip>
                    }
                </MChipGroup>

                @if (archiveTarget == ArchiveTarget.MacroGoal)
                {
                    if (macroGoals.Count == 0)
                    {
                        <div class="review-desc">@(I18n.T("Nothing here yet"))</div>
                    }
                    else
                    {
                        <MChipGroup Class="review-chip-group"
                                    Multiple="true">
                            @foreach (var goal in macroGoals)
                            {
                                <MChip @key="goal.Id"
                                       Class="@ChipClass(macroGoalId == goal.Id)"
                                       Filter="true"
                                       IsActive="macroGoalId == goal.Id"
                                       OnClick="@(() => macroGoalId = macroGoalId == goal.Id ? null : goal.Id)">
                                    @goal.Title
                                </MChip>
                            }
                        </MChipGroup>
                    }
                }

                <MButton Class="review-add"
                         Disabled="@(archiveSaving || string.IsNullOrWhiteSpace(takeaway) || (archiveTarget == ArchiveTarget.MacroGoal && !macroGoals.Any(it => it.Id == macroGoalId)))"
                         OnClick="ArchiveTakeawayAsync">
                    <MIcon Left="true">archive</MIcon>
                    @(I18n.T("Archive it"))
                </MButton>
            </div>

            <div class="review-section">
                <div class="review-label">@(I18n.T("Next step"))</div>
                <div class="review-desc">@(I18n.T(LessonText.NextStepDescription))</div>
                <MTextarea @bind-Value="nextStep"
                           @bind-Value:after="MarkDirty"
                           Class="review-textarea"
                           Rows="2">
                </MTextarea>
            </div>

            @*回访：到期回来看下一步有没有做到、关系有没有变化。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("Follow-up"))</div>
                <div class="review-desc">@(I18n.T(LessonText.FollowUpDescription))</div>
                <MButton Class="review-add"
                         OnClick="@(() => showFollowUpDatePicker = true)">
                    <MIcon Left="true">event</MIcon>
                    @(I18n.T("Follow-up due")) · @(followUpDueTime?.ToString("yyyy/MM/dd") ?? string.Empty)
                </MButton>
                <MChipGroup Class="review-chip-group"
                            Multiple="true">
                    @foreach (var status in followUpStatuses)
                    {
                        <MChip @key="status"
                               Class="@ChipClass(followUpStatus == status)"
                               Filter="true"
                               IsActive="followUpStatus == status"
                               OnClick="@(() => ToggleFollowUpStatus(status))">
                            @(I18n.T(status.ToString()))
                        </MChip>
                    }
                </MChipGroup>
                <div class="review-subitem">
                    <div class="review-subitem-label">@(I18n.T("Follow-up note"))</div>
                    <MTextarea @bind-Value="followUpNote"
                               @bind-Value:after="MarkDirty"
                               Class="review-textarea"
                               Rows="2">
                    </MTextarea>
                </div>
            </div>

            @*总结放最后：先把经历、感受和收获写完，再回头归类这段相处完成了什么课题。*@
            <div class="review-section">
                <div class="review-label">@(I18n.T("Lesson type"))</div>
                <div class="review-desc">@(I18n.T(LessonText.TypeDescription))</div>
                <MChipGroup Class="review-chip-group"
                            Multiple="true">
                    @foreach (var type in lessonTypes)
                    {
                        <MChip @key="type"
                               Class="@ChipClass(selectedTypes.Contains(type))"
                               Filter="true"
                               IsActive="selectedTypes.Contains(type)"
                               OnClick="@(() => ToggleType(type))">
                            <MIcon Left="true">@GlobalConfiguration.GetLessonTypeIcon(type)</MIcon>
                            @(I18n.T(type.ToString()))
                        </MChip>
                    }
                </MChipGroup>
                @foreach (var type in lessonTypes.Where(it => selectedTypes.Contains(it)))
                {
                    <div class="review-picked">
                        <span class="font-weight-bold">@(I18n.T(type.ToString()))</span>
                        — @(I18n.T($"{type} description"))
                        <div class="review-type-source">@(I18n.T($"{type} source"))</div>
                    </div>
                }
            </div>
        </div>
    </ScrollContainer>
</div>

<div class="right-bottom-float-area">
    <MyFloatButton Icon="save"
                   Show="true"
                   OnClick="@(() => SaveAsync(true))">
    </MyFloatButton>
</div>

<MultiSizeDatePicker @bind-Visible="showDatePicker"
                     @bind-Value="SelectedDate"
                     Max="@Today">
</MultiSizeDatePicker>

<MultiSizeDatePicker @bind-Visible="showFollowUpDatePicker"
                     @bind-Value="SelectedFollowUpDate">
</MultiSizeDatePicker>

<InputDialog @bind-Visible="showAddPerson"
             Title="@(I18n.T("Who"))"
             Placeholder="@(I18n.T("Person name"))"
             MaxLength="50"
             OnOK="AddPersonAsync">
</InputDialog>

<InputDialog @bind-Visible="showAddTrigger"
             Title="@(I18n.T("Add trigger"))"
             Placeholder="@(I18n.T("Please enter content"))"
             MaxLength="50"
             OnOK="AddTriggerAsync">
</InputDialog>
