@page "/dailyReviewOverview"
@namespace SwashbucklerDiary.Rcl.Pages
@inherits ImportantComponentBase

<div class="d-flex flex-column" style="height:100%;">
    <MyAppBar Title="@(I18n.T("This week's daily reviews"))"
              OnClick="NavigateToBack">
    </MyAppBar>

    <ScrollContainer>
        <div class="review-form">
            @*只读：按日课章节 1.1 ~ 1.7 分组，把这一周每天的原文摊在同一页上，方便统计*@
            <div class="review-desc">@WeekRange</div>

            @if (!HasAny)
            {
                <EmptyResult Show="true"
                             Text="@I18n.T("No daily review was written this week")">
                </EmptyResult>
            }
            else
            {
                @if (LifeEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.1 @dailyTitles[0] · @CountLabel(LifeEntries.Count, "days")</div>
                        @foreach (var day in LifeEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                <div class="review-desc">@day.Sections.Life</div>
                            </div>
                        }
                    </div>
                }

                @if (StudyEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.2 @dailyTitles[1] · @CountLabel(StudyEntries.Count, "days")</div>
                        @foreach (var day in StudyEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                <div class="review-desc">@day.Sections.Study</div>
                            </div>
                        }
                    </div>
                }

                @if (PositiveEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.3 @dailyTitles[2] · @CountLabel(PositiveCount, "items")</div>
                        @foreach (var day in PositiveEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                @for (int i = 0; i < DailyReviewSections.ThreePositivesCount; i++)
                                {
                                    string item = day.Sections.ThreePositives.ElementAtOrDefault(i) ?? string.Empty;
                                    if (!string.IsNullOrWhiteSpace(item))
                                    {
                                        <div class="review-desc">@(i + 1). @item</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                @if (FailureEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.4 @dailyTitles[3] · @CountLabel(FailureCount, "items")</div>
                        @foreach (var day in FailureEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                @for (int g = 0; g < day.Sections.MicroFailures.Count; g++)
                                {
                                    var answers = day.Sections.MicroFailures[g];
                                    if (answers.All(string.IsNullOrWhiteSpace))
                                    {
                                        continue;
                                    }

                                    <div class="review-subitem">
                                        <div class="review-subitem-label">@(g + 1)</div>
                                        @for (int q = 0; q < answers.Length; q++)
                                        {
                                            if (string.IsNullOrWhiteSpace(answers[q]))
                                            {
                                                continue;
                                            }

                                            <div class="review-subitem-label">@(q + 1). @microFailureQuestions.ElementAtOrDefault(q)</div>
                                            <div class="review-desc">@answers[q]</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (EnergyEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.5 @dailyTitles[4] · @CountLabel(EnergyEntries.Count, "days")</div>
                        @foreach (var day in EnergyEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                <div class="review-desc">@day.Sections.EnergyNote</div>
                            </div>
                        }
                    </div>
                }

                @if (MoodEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.6 @dailyTitles[5] · @CountLabel(MoodEntries.Count, "days")</div>
                        @foreach (var day in MoodEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                @if (day.Mood is MoodKind mood)
                                {
                                    <div class="review-desc">@(I18n.T(mood.ToString()))</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(day.Sections.MoodNote))
                                {
                                    <div class="review-desc">@day.Sections.MoodNote</div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (AffirmationEntries.Count > 0)
                {
                    <div class="review-section">
                        <div class="review-label">1.7 @(I18n.T("Self affirmation")) · @CountLabel(AffirmationCount, "times")</div>
                        @foreach (var day in AffirmationEntries)
                        {
                            <div class="review-group">
                                <div class="review-group-head">
                                    <span class="review-group-index">@DayLabel(day)</span>
                                </div>
                                @foreach (var phrase in day.Affirmations)
                                {
                                    <div class="review-desc">@phrase</div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </ScrollContainer>
</div>
